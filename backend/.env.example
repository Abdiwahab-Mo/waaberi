DATABASE_URL=postgresql+psycopg2://waaberi:waaberi@db:5432/waaberi
SECRET_KEY=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
CORS_ORIGIN=http://localhost:3000
# Donations
# Hormuud EVC Plus receiving number / merchant code
EVC_NUMBER=+252 61 XXX XXXX
# WaafiPay (Hormuud) merchant account: sends an EVC Plus payment prompt to the donor's phone
# and confirms the donation automatically. Leave empty to use the manual "send money + transaction ID" flow.
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
# "demo" = try the flow with no real money (also the default when no keys are set), "sandbox" = WaafiPay test, "live" = real money
WAAFI_ENV=demo
# Regions donors can direct a gift to (comma-separated)
DONATION_REGIONS=Puntland,Banadir,Jubaland,South West,Hirshabelle,Galmudug,Diaspora
